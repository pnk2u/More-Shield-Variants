    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.lieonlion.dev"
      }
    },
    "mc-publish": {
      "modrinth": "CW2WWDUy",
      "curseforge": "1065262",
      "dependencies": [
        "fabric-api(required)#(ignore)",
        "cloth-config(required){modrinth:9s6osm5g}{curseforge:348521}",
        "modmenu(optional){modrinth:mOgUt4GM}{curseforge:308702}"
      ]
    }
  }
}
