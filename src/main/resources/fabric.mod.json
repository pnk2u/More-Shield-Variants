{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "pnku"
  ],
  "contributors": [
    "hypothetiKal"
  ],
  "contact": {
    "homepage": "https://www.pnku.de",
    "email": "contact@pnku.de",
    "sources": "https://github.com/pnk2u/More-Shield-Variants",
    "issues": "https://github.com/pnk2u/More-Shield-Variants/issues"
  },

  "license": "${mod_license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "de.pnku.lolmsv.MoreShieldVariants"
    ],
    "client": [
      "de.pnku.lolmsv.MoreShieldVariantsClient"
    ],
    "modmenu": [
      "de.pnku.lolmsv.config.MoreShieldVariantsConfigScreen"
    ]
  },
  "mixins": [
